        <div class="flex flex-wrap items-center gap-2">
          <button id="copyAllUsernamesBtn" class="text-xs px-3 py-1.5 rounded bg-slate-900 border border-slate-700 hover:border-cyber-cyan text-slate-300 hover:text-cyber-cyan transition font-tech flex items-center gap-1.5">
            <i class="fa-regular fa-copy"></i> Usernames
          </button>
          <button id="copyAllPasswordsBtn" class="text-xs px-3 py-1.5 rounded bg-slate-900 border border-slate-700 hover:border-cyber-green text-slate-300 hover:text-cyber-green transition font-tech flex items-center gap-1.5">
            <i class="fa-regular fa-copy"></i> Passwords
          </button>
          <button id="copyAllCombosBtn" class="text-xs px-3 py-1.5 rounded bg-cyber-cyan/10 border border-cyber-cyan text-cyber-cyan hover:bg-cyber-cyan hover:text-black transition font-tech font-bold flex items-center gap-1.5 glow-cyan">
            <i class="fa-solid fa-clone"></i> All Combos
          </button>
          <button id="exportCombosBtn" class="text-xs px-3 py-1.5 rounded bg-cyber-magenta/10 border border-cyber-magenta text-cyber-magenta hover:bg-cyber-magenta hover:text-black transition font-tech font-bold flex items-center gap-1.5 glow-magenta">
            <i class="fa-solid fa-file-arrow-down"></i> Export .TXT
          </button>
        </div>
      </div>

      <!-- Accounts Scrollable List Container -->
      <div id="accountsContainer" class="space-y-4 max-h-[calc(100vh-230px)] overflow-y-auto pr-1">
        <!-- Dynamic account cards will render here -->
        <div class="bg-cyber-card border border-slate-800/80 rounded-xl p-8 text-center flex flex-col items-center justify-center gap-3">
          <div class="w-12 h-12 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600 text-xl">
