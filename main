        <button id="extractBtn" class="mt-4 w-full py-3 bg-gradient-to-r from-cyber-cyan/20 via-cyber-cyan/40 to-cyber-cyan/20 border border-cyber-cyan text-cyber-cyan font-orbitron font-bold text-sm tracking-widest hover:bg-cyber-cyan hover:text-black transition duration-200 glow-cyan rounded flex items-center justify-center gap-2 uppercase">
