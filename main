  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 bg-cyber-black border border-cyber-cyan text-cyber-cyan font-tech text-xs px-4 py-3 rounded-lg shadow-2xl transition-all duration-300 transform translate-y-16 opacity-0 pointer-events-none flex items-center gap-3 glow-cyan z-50">
    <i class="fa-solid fa-square-check text-base"></i>
    <span id="toastMsg" class="tracking-wider">Copied to clipboard!</span>
  </div>

  <!-- JavaScript Parser Engine -->
  <script>
    const sampleText = `============================================================
Account: ramoskaye88@gmail.com:*hans*12HUID: 542048603Username: lalainekaye-20Garena Shell: 0Email: ram****@gmail.com (Verified)Mobile: +63 ****3043Country: PHNickname: art--- Facebook Information ---Facebook Username: Facebook Link: https://www.facebook.com/profile.php?id=1629300337401361Facebook Status: FB UNBIND or FB DELETED--- CODM Information ---Account Level: 400Server: 🇵🇭 Philippines (PH)IGN: [237QUErNHQBUID: 984376425227092--- Login History ---Last Login: August 17, 2026 | 08:51 PMLast Login From: Garena Account CenterLast Login IP: 88.177.219.136Last Login Country: FRAccount Status: Not CleanPowered by: @Dashakinzsuport
============================================================
Account: kier092e:09666743110kierUID: 518643617Username: kier092eGarena Shell: 0Email: diz****@gmail.com (Not Verified)Mobile: +63 ****3110Country: PHNickname: --- Facebook Information ---Facebook Username: Facebook Link: https://www.facebook.com/profile.php?id=1084172295685036Facebook Status: FB UNBIND or FB DELETED--- CODM Information ---Account Level: 400Server: 🇵🇭 Philippines (PH)IGN: 伊桑毅山UID: 707967013305568--- Login History ---Last Login: August 17, 2026 | 08:51 PMLast Login From: Garena Account CenterLast Login IP: 109.147.99.200Last Login Country: GBAccount Status: Not CleanPowered by: @Dashakinzsuport
============================================================`;

    const rawInput = document.getElementById('rawInput');
    const extractBtn = document.getElementById('extractBtn');
    const sampleBtn = document.getElementById('sampleBtn');
    const clearBtn = document.getElementById('clearBtn');
    const accountsContainer = document.getElementById('accountsContainer');
    const accountCounter = document.getElementById('accountCounter');
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');

    let parsedAccounts = [];

    // Core Log Parser Logic
    function parseLogs(text) {
      parsedAccounts = [];
      if (!text || !text.trim()) {
        renderAccounts();
        return;
      }

      // Regex matches pattern Account: username:password up to structural keywords
      const accountRegex = /Account:\s*([^\s:]+):([^\s]+?)(?=\s*UID:|\s*Username:|\s*Garena Shell:|\s*Email:|\s*================|\s*$)/gi;

      let match;
      let idCounter = 1;

      while ((match = accountRegex.exec(text)) !== null) {
        const username = match[1].trim();
        const password = match[2].trim();
        if (username && password) {
          parsedAccounts.push({
            id: idCounter++,
            username: username,
            password: password,
            combo: `${username}:${password}`
          });
        }
      }

      renderAccounts();
    }

    // Drag and Drop & File Upload handling
    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-cyber-cyan', 'bg-cyber-cyan/10');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-cyber-cyan', 'bg-cyber-cyan/10');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-cyber-cyan', 'bg-cyber-cyan/10');
      if (e.dataTransfer.files.length > 0) {
        readFiles(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        readFiles(e.target.files);
      }
    });

    function readFiles(files) {
      let combinedContent = '';
      let fileCount = files.length;
      let loadedCount = 0;

      Array.from(files).forEach(file => {
        if (!file.name.endsWith('.txt') && !file.name.endsWith('.log')) {
          showToast(`Skipped non-txt/log file: ${file.name}`);
          loadedCount++;
          return;
        }

        const reader = new FileReader();
        reader.onload = function(event) {
          combinedContent += '\n' + event.target.result;
          loadedCount++;
          if (loadedCount === fileCount) {
            rawInput.value = (rawInput.value ? rawInput.value + '\n' : '') + combinedContent;
            parseLogs(rawInput.value);
            showToast(`Uploaded & processed ${fileCount} file(s)!`);
          }
        };
        reader.readAsText(file);
      });
    }

    // Export combos as TXT
    function exportCombosToFile() {
      if (parsedAccounts.length === 0) {
        showToast('No combos available to export!');
        return;
      }

      const comboText = parsedAccounts.map(a => a.combo).join('\n');
      const blob = new Blob([comboText], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `extracted_combos_${Date.now()}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Exported combos file downloaded!');
    }

    // Render Cards to DOM
    function renderAccounts() {
      accountCounter.innerText = `${parsedAccounts.length} ACCOUNT${parsedAccounts.length === 1 ? '' : 'S'} DETECTED`;

      if (parsedAccounts.length === 0) {
        accountsContainer.innerHTML = `
          <div class="bg-cyber-card border border-slate-800/80 rounded-xl p-8 text-center flex flex-col items-center justify-center gap-3">
            <div class="w-12 h-12 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600 text-xl">
              <i class="fa-solid fa-ghost"></i>
            </div>
            <p class="text-xs font-tech text-slate-500 uppercase tracking-wider">No accounts detected in log input or uploaded files.</p>
          </div>`;
        return;
      }

      accountsContainer.innerHTML = parsedAccounts.map(acc => `
        <div class="bg-cyber-card border border-cyber-cyan/30 rounded-xl p-4 glow-cyan space-y-3 relative group">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <span class="text-[10px] font-tech text-cyber-cyan bg-cyber-cyan/10 border border-cyber-cyan/30 px-2 py-0.5 rounded uppercase tracking-wider">
              #${String(acc.id).padStart(2, '0')} // TARGET_CREDENTIAL
            </span>
            <span class="text-[10px] font-tech text-slate-400">READY_FOR_COPY</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <!-- Username Input -->
            <div class="space-y-1">
              <label class="text-[11px] font-tech text-slate-400 uppercase flex items-center gap-1.5">
                <i class="fa-solid fa-user text-cyber-cyan"></i> Username
              </label>
              <div class="flex items-center gap-2 bg-cyber-black border border-slate-800 rounded p-1.5 focus-within:border-cyber-cyan transition">
                <input type="text" readonly value="${acc.username}" id="user_${acc.id}" class="bg-transparent font-mono text-xs text-cyber-cyan outline-none w-full px-1 truncate">
                <button onclick="copyFieldValue('user_${acc.id}', this)" class="px-2 py-1 bg-slate-900 hover:bg-cyber-cyan hover:text-black border border-slate-700 text-slate-300 font-tech text-xs rounded transition shrink-0 flex items-center gap-1">
                  <i class="fa-regular fa-copy"></i> Copy
                </button>
              </div>
            </div>

            <!-- Password Input -->
            <div class="space-y-1">
              <label class="text-[11px] font-tech text-slate-400 uppercase flex items-center gap-1.5">
                <i class="fa-solid fa-key text-cyber-green"></i> Password
              </label>
              <div class="flex items-center gap-2 bg-cyber-black border border-slate-800 rounded p-1.5 focus-within:border-cyber-green transition">
                <input type="text" readonly value="${acc.password}" id="pass_${acc.id}" class="bg-transparent font-mono text-xs text-cyber-green outline-none w-full px-1 truncate">
                <button onclick="copyFieldValue('pass_${acc.id}', this)" class="px-2 py-1 bg-slate-900 hover:bg-cyber-green hover:text-black border border-slate-700 text-slate-300 font-tech text-xs rounded transition shrink-0 flex items-center gap-1">
                  <i class="fa-regular fa-copy"></i> Copy
                </button>
              </div>
            </div>
          </div>

          <!-- Combo Bar -->
          <div class="space-y-1 pt-1">
            <label class="text-[11px] font-tech text-slate-400 uppercase flex items-center gap-1.5">
              <i class="fa-solid fa-link text-cyber-yellow"></i> Combo (user:pass)
            </label>
            <div class="flex items-center gap-2 bg-cyber-black border border-slate-800 rounded p-1.5 focus-within:border-cyber-yellow transition">
              <input type="text" readonly value="${acc.combo}" id="combo_${acc.id}" class="bg-transparent font-mono text-xs text-cyber-yellow outline-none w-full px-1 truncate">
              <button onclick="copyFieldValue('combo_${acc.id}', this)" class="px-3 py-1 bg-slate-900 hover:bg-cyber-yellow hover:text-black border border-slate-700 text-slate-300 font-tech text-xs rounded transition shrink-0 font-bold flex items-center gap-1">
                <i class="fa-solid fa-clone"></i> Copy Combo
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Single Field Copy Utility
    function copyFieldValue(inputId, btnElement) {
      const input = document.getElementById(inputId);
      if (!input || !input.value) return;

      input.select();
      document.execCommand('copy');

      const originalText = btnElement.innerHTML;
      btnElement.innerHTML = `<i class="fa-solid fa-check text-cyber-green"></i> COPIED!`;
      showToast('Copied to clipboard!');

      setTimeout(() => {
        btnElement.innerHTML = originalText;
      }, 1500);
    }

    // Bulk Copy Utilities
    function copyBulkData(type) {
      if (parsedAccounts.length === 0) {
        showToast('No accounts available to copy!');
        return;
      }

      let textToCopy = '';
      if (type === 'usernames') {
        textToCopy = parsedAccounts.map(a => a.username).join('\n');
      } else if (type === 'passwords') {
        textToCopy = parsedAccounts.map(a => a.password).join('\n');
      } else if (type === 'combos') {
        textToCopy = parsedAccounts.map(a => a.combo).join('\n');
      }

      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = textToCopy;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempTextArea);

      showToast(`Copied ${parsedAccounts.length} ${type} to clipboard!`);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.innerText = msg;
      toast.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');

      setTimeout(() => {
        toast.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
      }, 2200);
    }

    // Event Handlers
    extractBtn.addEventListener('click', () => parseLogs(rawInput.value));
    rawInput.addEventListener('input', () => parseLogs(rawInput.value));

    sampleBtn.addEventListener('click', () => {
      rawInput.value = sampleText;
      parseLogs(sampleText);
      showToast('Sample log data loaded!');
    });

    clearBtn.addEventListener('click', () => {
      rawInput.value = '';
      fileInput.value = '';
      parseLogs('');
      showToast('Cleared input!');
    });

    document.getElementById('copyAllUsernamesBtn').addEventListener('click', () => copyBulkData('usernames'));
    document.getElementById('copyAllPasswordsBtn').addEventListener('click', () => copyBulkData('passwords'));
    document.getElementById('copyAllCombosBtn').addEventListener('click', () => copyBulkData('combos'));
    document.getElementById('exportCombosBtn').addEventListener('click', exportCombosToFile);

    // On Load Initializer
    window.onload = function() {
      rawInput.value = sampleText;
      parseLogs(sampleText);
    };
  </script>
</body>
</html>
